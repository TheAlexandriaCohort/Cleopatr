{
  "name": "cleopatr",
  "version": "0.6.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/web.mjs dev",
    "build": "next build",
    "start": "node scripts/web.mjs start",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:web": "node scripts/smoke-native.mjs",
    "typecheck": "tsc --noEmit",
    "build:cli": "node scripts/build-cli.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "package:runtime": "node scripts/package-runtime.mjs",
    "test:runtime:vm": "node scripts/build-runtime.mjs && node --import tsx runtime/tests/managed-vm.ts",
    "test:runtime:linux": "node scripts/test-runtime-linux.mjs",
    "cli": "tsx cli/main.ts",
    "api:local": "tsx control-plane/local.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@cedar-policy/cedar-wasm": "4.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "next": "16.3.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "sharp": "0.35.4"
  },
  "type": "module"
}
